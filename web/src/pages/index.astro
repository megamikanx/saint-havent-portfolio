---
/**
 * Home (layout from the Figma): two side-by-side photos (the left one
 * larger), vertical Chinese slogan columns down both sides, and the intro/bio
 * text centred underneath.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Img from "../components/Img.astro";
import VerticalText from "../components/VerticalText.astro";
import { getHomePage } from "../lib/content.ts";
import { t } from "../i18n/index.ts";

const page = await getHomePage();
const [left, right] = page.featuredImages;
const slogan = t("decor.slogan");
---

<BaseLayout description={page.seoDescription ?? page.intro} shareImage={left}>
  <h1 class="visually-hidden">{page.heading}</h1>

  <section class="home">
    <div class="home__rail home__rail--left">
      <VerticalText text={slogan} class="vertical-text--slogan" />
      <VerticalText text={slogan} class="vertical-text--slogan home__slogan-offset" />
    </div>

    <div class="home__photos">
      {
        left && (
          <Img
            image={left}
            aspect={520 / 628}
            sizes="(min-width: 1200px) 520px, 54vw"
            widths={[400, 520, 780, 1040]}
            loading="eager"
            fetchpriority="high"
            class="home__photo home__photo--large"
          />
        )
      }
      {
        right && (
          <Img
            image={right}
            aspect={423 / 512}
            sizes="(min-width: 1200px) 423px, 44vw"
            widths={[320, 423, 640, 846]}
            loading="eager"
            class="home__photo home__photo--small"
          />
        )
      }
    </div>

    <div class="home__rail home__rail--right">
      <VerticalText text={slogan} class="vertical-text--slogan" />
    </div>
  </section>

  {page.intro && <p class="home__bio">{page.intro}</p>}
</BaseLayout>
