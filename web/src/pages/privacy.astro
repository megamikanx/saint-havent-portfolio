---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageFrame from "../components/PageFrame.astro";
import PortableText from "../components/PortableText.astro";
import { getPrivacyPage } from "../lib/content.ts";
import { t } from "../i18n/index.ts";

const page = await getPrivacyPage();
const updated = page.updated
  ? new Date(page.updated).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })
  : undefined;
---

<BaseLayout title={page.heading} description={page.seoDescription}>
  <PageFrame title={page.heading} zh={t("decor.page.privacy")} narrow>
    {updated && <p class="muted">{t("privacy.updated")} <time datetime={page.updated}>{updated}</time></p>}
    <PortableText value={page.body} />
  </PageFrame>
</BaseLayout>
