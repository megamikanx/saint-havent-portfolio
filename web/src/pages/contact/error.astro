---
// Shown after a failed submission when JavaScript is off.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageFrame from "../../components/PageFrame.astro";
import { t } from "../../i18n/index.ts";
---

<BaseLayout title={t("contact.heading")} noindex>
  <PageFrame title={t("contact.heading")} zh={t("decor.page.contact")}>
    <p class="form-alert" role="alert">{t("contact.error.generic")}</p>
    <p class="back-link"><a href="/contact/">← {t("nav.contact")}</a></p>
  </PageFrame>
</BaseLayout>
