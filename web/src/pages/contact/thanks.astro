---
// Shown after a successful submission when JavaScript is off.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageFrame from "../../components/PageFrame.astro";
import { t } from "../../i18n/index.ts";
---

<BaseLayout title={t("contact.success.heading")} noindex>
  <PageFrame title={t("contact.heading")} zh={t("decor.page.contact")}>
    <div class="contact__success">
      <h2>{t("contact.success.heading")}</h2>
      <p>{t("contact.success.body")}</p>
    </div>
  </PageFrame>
</BaseLayout>
