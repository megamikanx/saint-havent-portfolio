---
/**
 * Responsive photo grid with an accessible lightbox.
 *
 * Without JavaScript each thumbnail is a normal link to the full image. With
 * JavaScript, clicking opens a modal <dialog>:
 * - Escape, the close button or clicking the backdrop closes it
 * - Left/Right arrow keys and swipes move between photos
 * - Focus stays inside the dialog while open, and returns to the thumbnail
 *   that opened it when it closes
 */
import Img from "./Img.astro";
import { sanityImageUrl } from "../lib/sanity.ts";
import type { Photo } from "../lib/types.ts";
import { t } from "../i18n/index.ts";

type Props = { photos: Photo[]; galleryId: string; eagerFirst?: boolean };
const { photos, galleryId, eagerFirst = false } = Astro.props;

const FULL_WIDTHS = [800, 1200, 1600, 2000, 2400];

/** Full-size sources for the lightbox (not loaded until a photo is opened). */
function fullSize(photo: Photo) {
  const img = photo.image;
  if (img.kind === "local") return { src: img.src, srcset: "" };
  const widths = FULL_WIDTHS.filter((w) => w <= img.width);
  const list = widths.length ? widths : [img.width];
  return {
    src: sanityImageUrl(img.source, { width: list[list.length - 1]! }),
    srcset: list.map((w) => `${sanityImageUrl(img.source, { width: w })} ${w}w`).join(", "),
  };
}
---

<ul class="photo-grid" data-gallery={galleryId}>
  {
    photos.map((photo, i) => {
      const full = fullSize(photo);
      return (
        <li>
          <a
            class="photo-grid__item"
            href={full.src}
            data-index={i}
            data-src={full.src}
            data-srcset={full.srcset}
            data-width={photo.image.width}
            data-height={photo.image.height}
            data-alt={photo.image.alt}
            data-caption={photo.caption ?? ""}
            aria-label={t("photo.open", { alt: photo.image.alt })}
          >
            <Img
              image={photo.image}
              aspect={4 / 5}
              sizes="(min-width: 1100px) 340px, (min-width: 700px) 33vw, 50vw"
              widths={[320, 480, 640, 800]}
              loading={eagerFirst && i < 2 ? "eager" : "lazy"}
              fetchpriority={eagerFirst && i === 0 ? "high" : "auto"}
              alt=""
            />
          </a>
          {photo.caption && <p class="photo-grid__caption">{photo.caption}</p>}
        </li>
      );
    })
  }
</ul>

<dialog class="lightbox" data-lightbox={galleryId} aria-label={t("lightbox.label")}>
  <div class="lightbox__inner">
    <button type="button" class="lightbox__close" data-action="close">
      <span aria-hidden="true">×</span>
      <span class="visually-hidden">{t("lightbox.close")}</span>
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" decoding="async" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <div class="lightbox__controls">
      <button type="button" data-action="prev">
        <span aria-hidden="true">←</span>
        <span class="visually-hidden">{t("lightbox.previous")}</span>
      </button>
      <p class="lightbox__counter" aria-live="polite" data-template={t("lightbox.counter")}></p>
      <button type="button" data-action="next">
        <span aria-hidden="true">→</span>
        <span class="visually-hidden">{t("lightbox.next")}</span>
      </button>
    </div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLUListElement>("[data-gallery]").forEach((grid) => {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-lightbox="${grid.dataset.gallery}"]`);
    if (!dialog || typeof dialog.showModal !== "function") return;

    const items = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".photo-grid__item"));
    const img = dialog.querySelector<HTMLImageElement>(".lightbox__img")!;
    const caption = dialog.querySelector<HTMLElement>(".lightbox__caption")!;
    const counter = dialog.querySelector<HTMLElement>(".lightbox__counter")!;
    const template = counter.dataset.template ?? "{current} / {total}";
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const d = items[index]!.dataset;
      img.removeAttribute("srcset");
      img.src = d.src ?? "";
      if (d.srcset) img.srcset = d.srcset;
      img.sizes = "100vw";
      img.width = Number(d.width);
      img.height = Number(d.height);
      img.alt = d.alt ?? "";
      caption.textContent = d.caption ?? "";
      caption.hidden = !d.caption;
      counter.textContent = template
        .replace("{current}", String(index + 1))
        .replace("{total}", String(items.length));
    };

    items.forEach((item, i) =>
      item.addEventListener("click", (e) => {
        // Let modified clicks (new tab etc.) behave like normal links.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        opener = item;
        show(i);
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>("[data-action=close]")!.focus();
      }),
    );

    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const action = target.closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action === "close" || target === dialog) dialog.close();
      else if (action === "prev") show(index - 1);
      else if (action === "next") show(index + 1);
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      else if (e.key === "ArrowRight") show(index + 1);
      else if (e.key === "Tab") {
        // Keep Tab cycling through the dialog's own buttons.
        const focusable = Array.from(dialog.querySelectorAll<HTMLElement>("button"));
        const first = focusable[0]!;
        const last = focusable[focusable.length - 1]!;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
      // Escape is handled natively by <dialog> and fires "close".
    });

    // Swipe left/right on touch screens.
    let startX: number | null = null;
    dialog.addEventListener("touchstart", (e) => (startX = e.touches[0]?.clientX ?? null), { passive: true });
    dialog.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = (e.changedTouches[0]?.clientX ?? startX) - startX;
      if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
      startX = null;
    });

    dialog.addEventListener("close", () => {
      opener?.focus();
      img.removeAttribute("src");
      img.removeAttribute("srcset");
    });
  });
</script>
