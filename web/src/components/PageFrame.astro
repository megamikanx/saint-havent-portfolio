---
/**
 * Inner-page layout from the Figma:
 *
 *   ┌──────────────┬──────────────────────────┬──────────────┐
 *   │ [Title label]│   centred content column │   (empty)    │
 *   │              │   (stacked media + text) │              │
 *   └──────────────┴──────────────────────────┴──────────────┘
 *
 * On narrow screens the title stacks above the content.
 */

type Props = {
  /** Page title: the black label at top-left, and the page's <h1>. */
  title: string;
  /** Narrower content column, e.g. for the privacy policy. */
  narrow?: boolean;
};
const { title, narrow = false } = Astro.props;
---

<div class="page-frame">
  <div class="page-frame__rail">
    <h1 class="title-label">{title}</h1>
  </div>
  <div class:list={["page-frame__content", { "page-frame__content--narrow": narrow }]}>
    <slot />
  </div>
  <div class="page-frame__aside"></div>
</div>
