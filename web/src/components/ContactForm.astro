---
/**
 * Contact form. Posts to the Cloudflare Pages Function at /api/contact.
 *
 * - Validates in the browser using the same rules as the server (lib/contact.ts)
 * - Shows inline errors linked to each field (aria-describedby / aria-invalid)
 * - Cloudflare Turnstile adds a hidden token the server verifies
 * - Works without JavaScript too: the function redirects to /contact/thanks/
 *   or /contact/error/
 */
import { ENQUIRY_TYPES, HONEYPOT_FIELD, LIMITS } from "../lib/contact.ts";
import { t, type UIKey } from "../i18n/index.ts";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="contact">
  <div class="contact__success" data-success hidden tabindex="-1">
    <h2>{t("contact.success.heading")}</h2>
    <p>{t("contact.success.body")}</p>
  </div>

  <form class="contact-form" method="post" action="/api/contact" data-contact-form>
    <p class="form-alert" role="alert" data-form-alert hidden></p>

    <div class="field">
      <label for="cf-name">{t("contact.name")} <span class="field__req">({t("contact.required")})</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength={LIMITS.nameMax} aria-describedby="cf-name-error" />
      <p class="field__error" id="cf-name-error" data-error-for="name"></p>
    </div>

    <div class="field">
      <label for="cf-email">{t("contact.email")} <span class="field__req">({t("contact.required")})</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength={LIMITS.emailMax} aria-describedby="cf-email-error" />
      <p class="field__error" id="cf-email-error" data-error-for="email"></p>
    </div>

    <div class="field">
      <label for="cf-type">{t("contact.enquiryType")} <span class="field__req">({t("contact.required")})</span></label>
      <select id="cf-type" name="enquiryType" required aria-describedby="cf-type-error">
        <option value="">{t("contact.enquiryType.choose")}</option>
        {ENQUIRY_TYPES.map((type) => <option value={type}>{t(`contact.enquiryType.${type}` as UIKey)}</option>)}
      </select>
      <p class="field__error" id="cf-type-error" data-error-for="enquiryType"></p>
    </div>

    <div class="field">
      <label for="cf-message">{t("contact.message")} <span class="field__req">({t("contact.required")})</span></label>
      <textarea id="cf-message" name="message" rows="7" required maxlength={LIMITS.messageMax} aria-describedby="cf-message-error"></textarea>
      <p class="field__error" id="cf-message-error" data-error-for="message"></p>
    </div>

    {/* Honeypot: hidden from people and screen readers; bots tend to fill it in. */}
    <div class="visually-hidden" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input id="cf-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
    </div>

    {
      siteKey ? (
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible" />
      ) : (
        <p class="form-note">{t("contact.turnstileMissing")}</p>
      )
    }

    <p class="form-note" set:html={t("contact.privacyNote", { link: `<a href="/privacy/">${t("footer.privacy")}</a>` })} />

    <button type="submit" class="button button--primary" data-submit>{t("contact.submit")}</button>
  </form>
</div>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { normalise, validateContact, type ContactField, type ContactResponse } from "../lib/contact.ts";
  import { t } from "../i18n/index.ts";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const success = document.querySelector<HTMLElement>("[data-success]");
  const alertBox = form?.querySelector<HTMLElement>("[data-form-alert]");
  const submit = form?.querySelector<HTMLButtonElement>("[data-submit]");

  type Turnstile = { reset: () => void };
  const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;

  function showErrors(errors: Partial<Record<ContactField, string>>) {
    if (!form) return;
    let firstInvalid: HTMLElement | null = null;
    form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
      const field = el.dataset.errorFor as ContactField;
      const input = form.elements.namedItem(field) as HTMLElement | null;
      const message = errors[field] ?? "";
      el.textContent = message;
      input?.setAttribute("aria-invalid", message ? "true" : "false");
      if (message && !firstInvalid) firstInvalid = input;
    });
    (firstInvalid as HTMLElement | null)?.focus();
  }

  function showAlert(message: string) {
    if (!alertBox) return;
    alertBox.textContent = message;
    alertBox.hidden = !message;
  }

  function collect() {
    const data = new FormData(form!);
    return normalise({
      name: data.get("name"),
      email: data.get("email"),
      enquiryType: data.get("enquiryType"),
      message: data.get("message"),
    });
  }

  // Our inline errors replace the browser's validation bubbles (kept for no-JS visitors).
  if (form) form.noValidate = true;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    showAlert("");

    // 1. Validate in the browser first for instant feedback.
    const keys = validateContact(collect());
    const messages = Object.fromEntries(Object.entries(keys).map(([f, k]) => [f, t(k)]));
    showErrors(messages);
    if (Object.keys(keys).length) {
      showAlert(t("contact.error.fixFields"));
      return;
    }

    // 2. Send to the server, which validates again and verifies Turnstile.
    submit!.disabled = true;
    submit!.textContent = t("contact.sending");
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = (await res.json().catch(() => ({ ok: false, error: "server", message: t("contact.error.generic") }))) as ContactResponse;

      if (result.ok) {
        form.hidden = true;
        success!.hidden = false;
        success!.focus();
        return;
      }
      if (result.error === "validation") {
        showErrors(result.errors);
        showAlert(t("contact.error.fixFields"));
      } else {
        showAlert(result.message);
      }
    } catch {
      showAlert(t("contact.error.network"));
    } finally {
      submit!.disabled = false;
      submit!.textContent = t("contact.submit");
      // Turnstile tokens are single-use, so get a fresh one for a retry.
      turnstile()?.reset();
    }
  });
</script>
