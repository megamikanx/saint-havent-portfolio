---
/**
 * A music release: cover, title, year, and a click-to-load Bandcamp player.
 * The artist can paste either a Bandcamp URL or the embed code; both are
 * turned into a player at build time.
 */
import Img from "./Img.astro";
import { bandcampEmbedUrl, resolveBandcamp } from "../lib/embeds.ts";
import { t } from "../i18n/index.ts";
import type { Release } from "../lib/types.ts";

type Props = { release: Release };
const { release } = Astro.props;

const embed = await resolveBandcamp(release.bandcamp);
const link = embed?.url ?? (release.bandcamp.startsWith("http") ? release.bandcamp : undefined);
---

<article class="release">
  {
    release.cover && (
      <Img image={release.cover} aspect={1} sizes="(min-width: 700px) 320px, 100vw" widths={[320, 480, 640, 960]} class="release__cover" />
    )
  }
  <div class="release__body">
    <h2 class="release__title">{release.title}</h2>
    {release.year && <p class="release__year">{release.year}</p>}

    {
      embed ? (
        <div class="facade facade--bandcamp" data-facade>
          <button type="button" class="button" data-embed={bandcampEmbedUrl(embed)} data-title={release.title}>
            <span aria-hidden="true">▶</span> {t("music.play", { title: release.title })}
          </button>
        </div>
      ) : null
    }
    {
      link && (
        <p class="release__link">
          <a href={link} target="_blank" rel="noopener noreferrer">
            {t("music.listen")}
            <span class="visually-hidden"> {t("footer.newTab")}</span>
          </a>
        </p>
      )
    }
  </div>
</article>

<script>
  import { activateFacades } from "../lib/facade-client.ts";
  activateFacades();
</script>
