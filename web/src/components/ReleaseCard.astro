---
/**
 * A music release in the stacked layout: cover, then title, year and a
 * Bandcamp player that shows straight away. The artist can paste either a Bandcamp URL
 * or the embed code; both are turned into a player at build time.
 */
import Img from "./Img.astro";
import { bandcampEmbedUrl, resolveBandcamp } from "../lib/embeds.ts";
import { t } from "../i18n/index.ts";
import type { Release } from "../lib/types.ts";

type Props = { release: Release };
const { release } = Astro.props;

const embed = await resolveBandcamp(release.bandcamp);
const link = embed?.url ?? (release.bandcamp.startsWith("http") ? release.bandcamp : undefined);
---

<article class="release">
  {
    release.cover && (
      <div class="stack__media stack__media--square">
        <Img image={release.cover} aspect={1} sizes="(min-width: 700px) 520px, 100vw" widths={[320, 520, 780, 1040]} />
      </div>
    )
  }
  <div class="stack__text">
    <h2 class="stack__title">{release.title}</h2>
    {release.year && <p class="release__year">{release.year}</p>}
    {
      embed && (
        <iframe
          class="release__player"
          src={bandcampEmbedUrl(embed)}
          title={t("music.player", { title: release.title })}
          loading="lazy"
          allow="autoplay; encrypted-media"
        />
      )
    }
    {
      link && (
        <p class="release__link">
          <a href={link} target="_blank" rel="noopener noreferrer">
            {t("music.listen")}
            <span class="visually-hidden"> {t("footer.newTab")}</span>
          </a>
        </p>
      )
    }
  </div>
</article>
