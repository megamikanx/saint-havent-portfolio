# Every environment variable the project uses. Never commit real values.
#
# Where each one goes:
#   web/.env          -> PUBLIC_* values, read when building the site (`npm run dev` / `npm run build`)
#   web/.dev.vars     -> server secrets, read by the contact Function when testing locally (`npm run preview`)
#   studio/.env       -> SANITY_STUDIO_* values for the Studio
#   Cloudflare Pages  -> Settings > Variables and Secrets: add every web variable (PUBLIC_* and secrets)
#
# See README.md for details.

# ---------- Sanity (web/.env and Cloudflare Pages) ----------
# From https://www.sanity.io/manage > your project. Leave empty to build with placeholder content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ---------- Site (web/.env and Cloudflare Pages) ----------
# The live URL, used for canonical links, share previews and the sitemap. No trailing slash.
SITE_URL=https://example.com

# ---------- Cloudflare Turnstile (spam protection) ----------
# Cloudflare dashboard > Turnstile > Add widget. For local testing use Cloudflare's
# always-pass test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Secret: web/.dev.vars locally, encrypted secret in Cloudflare Pages.
TURNSTILE_SECRET_KEY=

# ---------- Resend (email delivery) ----------
# Secret: https://resend.com/api-keys (web/.dev.vars locally, encrypted secret in Cloudflare Pages).
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. Saint Haven't <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
# Where enquiries go if no "Contact form email address" is set in Sanity's Site settings.
ARTIST_NOTIFICATION_EMAIL=

# ---------- Cloudflare Web Analytics (optional) ----------
# Only needed if you add the beacon manually. If you enable Web Analytics on the
# Pages project in the dashboard instead, leave this empty.
PUBLIC_CF_ANALYTICS_TOKEN=

# ---------- Sanity Studio (studio/.env) ----------
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# The Studio is deployed to https://<hostname>.sanity.studio
SANITY_STUDIO_HOSTNAME=
